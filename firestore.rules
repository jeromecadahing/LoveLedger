rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these two Google accounts can read or write anything.
    function isUs() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['ecadahing@gmail.com', 'tonsdinglasan@gmail.com'];
    }
    function myEmail() { return request.auth.token.email.lower(); }

    function validEntry(d) {
      return d.keys().hasOnly(['from','to','kind','currency','amount','total','bank','date','note','createdAt','settled','settledAt','by','notify'])
        && d.keys().hasAll(['from','to','kind','currency','amount','date','createdAt'])
        && d.from in ['A','B'] && d.to in ['A','B'] && d.from != d.to
        && d.kind in ['split','loan','repay']
        && d.currency in ['GBP','PHP']
        && d.amount is number && d.amount > 0 && d.amount < 10000000
        && (!('total' in d) || (d.total is number && d.total >= d.amount && d.total < 10000000))
        && d.date is string && d.date.size() == 10
        && (!('bank' in d) || (d.bank is string && d.bank.size() <= 60))
        && (!('note' in d) || (d.note is string && d.note.size() <= 200))
        && d.createdAt is number
        && (!('settled' in d) || d.settled is bool)
        && (!('settledAt' in d) || d.settledAt is number)
        && (!('by' in d) || d.by is string)
        && (!('notify' in d) || d.notify == true);
    }

    match /entries/{id} {
      allow read, delete: if isUs();
      allow create: if isUs() && validEntry(request.resource.data)
        && (!('by' in request.resource.data) || request.resource.data.by == myEmail());
      allow update: if isUs() && validEntry(request.resource.data);
    }

    match /settings/names {
      allow read: if isUs();
      allow write: if isUs()
        && request.resource.data.keys().hasOnly(['A','B'])
        && request.resource.data.A is string && request.resource.data.A.size() <= 30
        && request.resource.data.B is string && request.resource.data.B.size() <= 30;
    }

    // Each phone's notification address. The GitHub Action reads these with admin access.
    match /pushTokens/{token} {
      allow create, update: if isUs()
        && request.resource.data.keys().hasOnly(['email','createdAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.createdAt is number;
      allow delete: if isUs();
    }

    // "Send a reminder" requests, picked up and removed by the GitHub Action.
    match /nudges/{id} {
      allow create: if isUs()
        && request.resource.data.keys().hasOnly(['by','note','createdAt'])
        && request.resource.data.by == myEmail()
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.createdAt is number;
    }

    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
